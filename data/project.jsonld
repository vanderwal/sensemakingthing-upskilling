      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Outdated Small-Organization Elections",
      "description": "Unions, HOAs, and nonprofit boards run consequential elections on paper ballots and opaque spreadsheets; available tools serve incumbent leadership rather than transparent, verifiable results for members.",
