      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Calls for Stricter Ballot ID",
      "description": "A demand that in-person voting require Real ID and that mail-in ballots require verified identification — described by the submitter as widely supported yet repeatedly rejected.",
      "x": 172.6011883070587,
      "y": 1157.8312064809668,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-39",
      "children": []
    },
    {
      "@id": "item_40",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Women Still Under-Represented",
      "description": "Women remain under-represented in political leadership, even as women run for the highest offices.",
      "x": 19.95424913400288,
      "y": 1021.612257901066,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-40",
      "children": []
    },
    {
      "@id": "item_41",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Student Technology Access Gap",
      "description": "Students lack access to equipment for training, and school technology funding isn't keeping up; grassroots fundraisers and lobbying for federal funding only go so far.",
      "x": 133.57571346918564,
      "y": 1341.0417464595193,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
      "source_url": "https://theupskillinglabs.org/survey/civics/results#r-41",
